{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "demo/dist/**",
    ".nyc_output/**",
    "test/typegen/sanity.types.ts",
    // The Next.js integration fixture resolves `next` types from its own node_modules, which
    // only exist while `pnpm test:next` runs - type-aware linting can't see them from the root
    "test/next-app/**"
  ],
  "plugins": ["eslint", "typescript", "unicorn", "react", "react-perf", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-console": "error",
    "no-array-sort": "off",
    "rules-of-hooks": "error",
    "react-in-jsx-scope": "off",
    // React Compiler: recommended/correctness rules are on via categories.
    // Enable remaining rules from https://oxc.rs/blog/2026-08-18-react-compiler-support
    "react/unsupported-syntax": "error",
    "react/no-deriving-state-in-effects": "error",
    "react/invariant": "error",
    "react/rule-suppression": "error",
    "react/syntax": "error",
    "react/todo": "error",
    "react/capitalized-calls": "error",
    "react/exhaustive-effect-dependencies": "error",
    "react/hooks": "error",
    "react/memo-dependencies": "error",
    "no-deprecated": "error",
    // @TODO these rules should be enabled, and the violations fixed
    "no-unsafe-type-assertion": "off",
    "no-underscore-dangle": "off"
  },
  "overrides": [
    {
      "files": ["test/**"],
      "rules": {
        "no-console": "off",
        "no-unsafe-type-assertion": "off",
        "consistent-function-scoping": "off"
      }
    }
  ]
}
